# Copy to .env. `docker compose up -d` serves the database on 5433 so it does
# not collide with a postgres already running on the host.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://listings:listings@localhost:5433/listings

# Requests per minute, per IP.
THROTTLE_LIMIT=100

# Integration tests run against their own database so a test run cannot wipe
# the data you were looking at. Created by `pnpm db:test:create`.
TEST_DATABASE_URL=postgres://listings:listings@localhost:5433/listings_test
